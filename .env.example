# Cloudflare R2 bucket used for Clipora-owned brand/media assets.
# Configure the bucket binding in the appropriate Wrangler environment before deploy.
R2_BUCKET=clipora-assets

# Optional public origin for media assets. Keep empty for local development.
CLIPORA_ASSET_ORIGIN=

# Optional API origin used by the web application in production.
VITE_API_ORIGIN=http://localhost:8787
